# ===== Konfigurasi Sistem Nilai Zero Trust =====
# Salin menjadi .env (npm run setup melakukannya otomatis). Ganti nilai rahasia untuk selain demo.

# Port & alamat bind (default: hanya localhost)
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002
BIND_HOST=127.0.0.1

# Alamat antar-komponen
GATEWAY_URL=http://localhost:3000
NILAI_URL=http://localhost:3001
TRANSKRIP_URL=http://localhost:3002

# Secret yang disisipkan gateway ke setiap request ke service (header X-Gateway-Secret)
GATEWAY_SECRET=ganti-dengan-secret-gateway-acak-min-16-karakter

# Kredensial Service Nilai untuk POST /auth/service
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=ganti-dengan-secret-service-nilai-acak

# Lokasi database SQLite bersama dan file kebijakan (jam akses)
DB_PATH=data/sistem_nilai.db
POLICY_FILE=config/policy.json
